# OXBOW environment. This file is COMMITTED and contains no secrets.
# The real .env is never committed. Copy it and fill in the values:
#
#   cp .env.example .env
#
# 02 F: secrets from the environment, .env.example committed, .env never, and a
# pre-commit hook scans for keys.

# --- required ------------------------------------------------------------
# Per-run salt for account de-identification. The account_key is
# sha256(account_id + RUN_SALT)[:12], uppercased and shown as ACC-7F2A19.
# 01 A rule 8: the salt is per-run and lives in the environment, not the repo.
# Re-identification requires the salt, so losing it is what makes an erasure
# request satisfiable while leaving the audit chain intact (03 L).
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
RUN_SALT=

# Global seed, propagated to NumPy, LightGBM, Optuna, the Monte Carlo engine and
# the injector. Changing it breaks `make verify-determinism`.
OXBOW_SEED=1337

# --- postgres ------------------------------------------------------------
POSTGRES_USER=oxbow
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=oxbow
# Not 5432. docker-compose publishes the container on ${POSTGRES_PORT:-5433} because
# something else on this machine already owns host 5432 — a native postgres that answers
# a connection attempt with `role "oxbow" does not exist`, which reads as a broken
# password rather than as the wrong server. Keep this and DATABASE_URL in step with the
# compose default or a host-side command talks to a database that is not this project.
POSTGRES_PORT=5433

# --- redis (RQ: pipeline and backtest jobs) ------------------------------
REDIS_PORT=6379

# --- minio (object storage) ---------------------------------------------
MINIO_USER=oxbow
MINIO_PASSWORD=change_me_local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- mlflow (experiment and model registry) ------------------------------
MLFLOW_PORT=5000

# --- keycloak (OIDC authorization code + PKCE; dev mode only) ------------
# This is a research prototype, not an identity product. A local JWT fallback
# keeps the offline demo working with Keycloak stopped.
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_local
KEYCLOAK_REALM=oxbow
KEYCLOAK_CLIENT_ID=oxbow-web
KEYCLOAK_CLIENT_SECRET=change_me_local

# --- outbound webhook signing (02 E) ------------------------------------
# Signs X-OXBOW-Signature: t=<unix>,v1=<hex> over t + "." + raw_body with
# HMAC-SHA256, 300-second replay window, constant-time compare.
WEBHOOK_SIGNING_SECRET=change_me_local
# Endpoint the null webhook adapter would POST to. The Compose echo service
# verifies the signature and records deliveries.
WEBHOOK_ENDPOINT=http://localhost:8099/webhook

# --- ports ---------------------------------------------------------------
API_PORT=8000
ECHO_PORT=8099
WEB_PORT=3000

# ------------------------------------------------------------------ runtime
# Everything below is read by code at start-up. Listed here because a value
# that only exists in someone's shell is how a working tree becomes a
# non-reproducible one, and because three of these were being supplied under a
# different name than the one the code reads (see the RUN_SALT and
# NEXT_PUBLIC_API_BASE_URL notes on docker-compose.yml).

# Which warehouse the API reads. "postgres" is the real path; anything else is
# the file/read-only fallback used by offline demo runs. Read by apps/api/deps.py.
OXBOW_WAREHOUSE=postgres

# SQLAlchemy URL for the pipeline and `make verify-audit`. docker-compose injects
# its own for the containers; set it here only to point a HOST-side run at a
# database. When it is absent, verify-audit prints SKIPPED for the warehouse
# chains -- it does not treat "no database" as a pass.
# DATABASE_URL=postgresql+psycopg://oxbow:CHANGE_ME@127.0.0.1:5433/oxbow

# Tracking store for model lineage. Unset means MLflow is skipped and the run
# records that it was skipped.
# OXBOW_MLFLOW_URL=http://127.0.0.1:5000

# Watchlist used by the sanctions rule. Points at the repo's synthetic sample so
# a fresh clone runs without fetching anything licensed; replace with a real
# distribution only after checking its terms.
OXBOW_WATCHLIST_PATH=data/watchlist/sample-sdn-v1.csv

# Structured vs plain log output; apps/api/main.py.
OXBOW_LOG_FORMAT=plain

# Parallelism for identifier re-hashing during ingest (apps/api deps and the
# pipeline both cap this; it changes speed, never bytes -- the determinism gate
# would fail otherwise).
OXBOW_HASH_WORKERS=4

# ------------------------------------------------------------------ web (build-time)
# Next.js inlines NEXT_PUBLIC_* at BUILD time, so these must be present when
# `bun run build` runs, not only when the server starts. Read by
# apps/web/src/lib/api/transport.ts.

# Where the browser sends API requests. Inside the compose stack this is set to
# http://api:8000 -- the service name, because inside the web container 127.0.0.1 is that
# container and there is no API there. The variable name has to match what transport.ts reads,
# which is why compose no longer calls it NEXT_PUBLIC_API_BASE. The browser never uses this
# value: transport.ts sends relative /api paths from the page and lets the edge route them.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# "live" talks to the API; "fixture" renders the bundled samples. Fixture mode is
# the offline demo path and must never be presented as real data.
NEXT_PUBLIC_OXBOW_TRANSPORT=live

# Fixture rendering is refused in a production build by default. Set to 1 only to
# build the offline state gallery, where fixtures ARE the subject.
# OXBOW_ALLOW_FIXTURE_BUILD=1

# Server-side trigger that makes the ROOT LAYOUT throw, so global-error.tsx -- the
# fourth and last error tier -- can be painted and checked in a browser instead of
# asserted to work. Read before anything renders and unreadable from a URL, so it can
# only be set by whoever runs the browser checks. Never set it in a deployed build.
# OXBOW_GLOBAL_ERROR_PROBE=1

# ------------------------------------------------------------------ webhook receiver
# apps/api/echo.py runs with these names (compose maps WEBHOOK_SIGNING_SECRET onto
# SIGNING_SECRET). Both previously had a default that was published in this repo, which
# made a forged-but-valid signature possible for anyone who read the source; the
# receiver now refuses with 503 instead of falling back.

# Hmac key for verifying inbound deliveries. Must equal the sender's value.
SIGNING_SECRET=change_me_local

# Where received deliveries are appended. A container path; mount a volume for it.
RECORD_PATH=/data/deliveries.jsonl

# The origin next.config.ts's `/api/*` rewrite forwards to. On the host, where `make api` puts
# FastAPI on 127.0.0.1:8000, this is right as written. In the compose stack the `web` service
# overrides it to http://api:8000, because 127.0.0.1 inside that container is the container.
OXBOW_API_ORIGIN=http://127.0.0.1:8000

# ------------------------------------------------------------------ edge (caddy)
# The one origin a browser is told about: config/caddy/Caddyfile routes /api/* to the API and
# everything else to the Next app, which is what keeps the OIDC cookie session same-origin
# without a CORS exception. DEV-023.
#
# One variable sets both the container's listen port and the host port compose publishes, so
# changing it moves the whole edge rather than half of it. It is not 80 or 443 on purpose: those
# are free here but they need elevation, and an edge that needs elevation is one nobody demos.
# OXBOW_EDGE_PORT=8080

# ------------------------------------------------------------------ browser checks (P8)
# Read by apps/web/playwright.config.ts and the state specs. Nothing here is a secret and
# nothing is baked into a build: they say where the servers are on the machine running the
# checks, and which chromium to launch. `make` does not exist on this host, so every gate runs
# as the command the recipe would have run -- `node node_modules/vitest/vitest.mjs run`, `node node_modules/next/dist/bin/next start` -- and the
# suite points at the chromium already in the ms-playwright cache instead of downloading one;
# set OXBOW_CHROME_PATH if your cache lives elsewhere, and it will be used verbatim.

# The web app the suite drives. The dev server is started externally, not by Playwright.
# OXBOW_WEB_BASE_URL=http://127.0.0.1:3100

# Second target, for the specs that check a *live* surface against fidelity expectations
# rather than driving the dev server. Read by
# apps/web/tests/states/explorer-and-fidelity.spec.ts, which falls back to
# http://127.0.0.1:3101 when this is unset -- so it is declared for the clone case, where
# the port has to be stated rather than assumed, not because the spec refuses to run
# without it. Those specs record a skip naming what to start; they never report a pass
# they did not earn.
# OXBOW_LIVE_WEB_BASE_URL=http://127.0.0.1:3101

# Absolute path to the chromium binary to launch. Default: the newest chromium found in
# this OS's Playwright browser cache (%LOCALAPPDATA%\ms-playwright on Windows,
# ~/.cache/ms-playwright or $XDG_CACHE_HOME/ms-playwright on Linux,
# ~/Library/Caches/ms-playwright on macOS). Set it only to force a specific build.
# Never `playwright install` on a box that already has one -- it downloads a browser silently.
# OXBOW_CHROME_PATH=/path/to/ms-playwright/chromium-1243/chrome-win64/chrome.exe

# The account the network-explorer probe opens first. An account key, not a secret: it is
# chosen from the landed corpus so the probe asks about something that exists.
# OXBOW_STRESS_ACCOUNT=ACC-00DORM
